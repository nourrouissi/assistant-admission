# ============================================================
# Modèle de configuration : copier ce fichier en ".env"
# puis remplacer les valeurs. Le fichier .env n'est jamais
# envoyé sur GitHub (voir .gitignore).
# ============================================================
DJANGO_SECRET_KEY=change-moi
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200
# --- Base de données PostgreSQL + pgvector (Docker) ---
POSTGRES_DB=admission
POSTGRES_USER=admission
POSTGRES_PASSWORD=change-moi
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- LLM principal : Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# --- LLM de secours : Groq ---
GROQ_API_KEY=
GROQ_MODEL=

# --- E-mails (Mailpit en développement) ---
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=admissions@imset.example
BUSINESS_TEAM_EMAILS=equipe-admissions@imset.example
# ============================================================
# Modèle de configuration : copier ce fichier en ".env"
# puis remplacer les valeurs. Le fichier .env n'est jamais
# envoyé sur GitHub (voir .gitignore).
# ============================================================
DJANGO_SECRET_KEY=change-moi
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200
# --- Base de données PostgreSQL + pgvector (Docker) ---
POSTGRES_DB=admission
POSTGRES_USER=admission
POSTGRES_PASSWORD=change-moi
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- LLM principal : Gemini (API compatible OpenAI) ---
LLM_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.5-flash
# --- Secours 1 : second modèle Gemini (même clé, quota séparé) ---
LLM_SECONDARY_MODEL=gemini-3.5-flash-lite
# --- Secours 2 : Groq ---
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# --- Embeddings (modèle exécuté en local, téléchargé au premier lancement) ---
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# --- E-mails (Mailpit en développement) ---
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=admissions@example.test
BUSINESS_TEAM_EMAILS=admissions@example.test
ADMISSIONS_CONTACT=admissions@test.local
